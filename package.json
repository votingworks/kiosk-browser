{
  "name": "kiosk-browser",
  "version": "1.2.1",
  "description": "Generic kiosk-mode browser.",
  "keywords": [],
  "homepage": "https://github.com/votingworks/kiosk-browser",
  "license": "GPL-3.0-only",
  "author": {
    "name": "VotingWorks",
    "email": "eng@voting.works"
  },
  "main": "build/src/index.js",
  "scripts": {
    "app:dir": "electron-builder --dir",
    "app:dist": "USE_SYSTEM_FPM=true electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "pnpm lint --fix",
    "prepare": "husky",
    "start": "tsc && electron .",
    "test": "jest",
    "test:ci": "pnpm test:coverage",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "lint-staged": {
    "*.ts": "eslint --quiet --fix",
    "package.json": "sort-package-json"
  },
  "dependencies": {
    "chalk": "^3.0.0",
    "debug": "^4.1.1",
    "xrandr-parse": "^1.0.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.5",
    "@types/jest": "^27.5.1",
    "@types/memorystream": "^0.3.0",
    "@types/node": "24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "electron": "44",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^10.0.7",
    "memorystream": "^0.3.1",
    "prettier": "^2.6.2",
    "sort-package-json": "^1.39.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.votingworks.kiosk-browser",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "build/src/**/*"
    ],
    "linux": {
      "target": "deb",
      "category": "Utility"
    }
  },
  "packageManager": "pnpm@12.9.1",
  "productName": "kiosk-browser"
}
